---
// The theme switch sits before the social links, per the design.
// Its label and aria-pressed are synced by theme.js on every page load;
// the values here are the dark default, which is also the first-visit state.
---

<footer class="site-footer">
  <span class="type-meta">Erik Drouhard · Worcester, MA</span>
  <div class="footer-right">
    <button type="button" class="theme-toggle type-meta" aria-pressed="false" aria-label="Toggle color theme">
      <span class="switch type-meta" aria-hidden="true"></span>
      <span class="theme-label type-meta">Dark</span>
    </button>
    <span class="social type-meta">
      <a class="type-meta" href="https://www.linkedin.com/in/erikdrouhard">LinkedIn</a>
      <a class="type-meta" href="https://github.com/erikdrouhard">GitHub</a>
      <a class="type-meta" href="https://x.com/erikdrouhard">X</a>
      <a class="type-meta" href="https://www.instagram.com/ekdr0">Instagram</a>
      <a class="type-meta" href="mailto:erikdrouhard@gmail.com">Contact</a>
    </span>
  </div>
</footer>
