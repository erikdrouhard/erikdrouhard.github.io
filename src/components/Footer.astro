---
// The theme switch sits before the social links, per the design.
// Its label and aria-pressed are synced by theme.js on every page load;
// the values here are the dark default, which is also the first-visit state.
---

<footer class="site-footer">
  <span>Erik Drouhard · Worcester, MA</span>
  <div class="footer-right">
    <button type="button" class="theme-toggle" aria-pressed="false" aria-label="Toggle color theme">
      <span class="switch" aria-hidden="true"></span>
      <span class="theme-label">Dark</span>
    </button>
    <span class="social">
      <a href="https://www.linkedin.com/in/erikdrouhard">LinkedIn</a>
      <a href="https://github.com/erikdrouhard">GitHub</a>
      <a href="https://x.com/erikdrouhard">X</a>
      <a href="https://www.instagram.com/ekdr0">Instagram</a>
      <a href="mailto:erikdrouhard@gmail.com">Contact</a>
    </span>
  </div>
</footer>
