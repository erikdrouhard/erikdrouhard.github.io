---
import { ClientRouter } from "astro:transitions";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";

import "@fontsource-variable/newsreader";
import "@fontsource-variable/jetbrains-mono";
// tokens.css is the whole design system and must land first: every other
// stylesheet reads from it and writes no literals of its own.
import "../styles/tokens.css";
import "../styles/theme.css";

// Preloaded so the swap from the fallback face happens during load rather than
// after first paint. Only the latin subsets — the other unicode-ranges never
// download for English content, and preloading them would waste the budget.
import newsreaderLatin from "@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url";
import monoLatin from "@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  /** "full" on home / about, "quiet" on reading pages, "off" for a static frame. */
  field?: "full" | "quiet" | "off";
  noindex?: boolean;
  /** Extra class on <body>. Ported case studies use it to scope their CSS,
      e.g. "drive-page" — exactly the hook those stylesheets were written for. */
  bodyClass?: string;
  /** "default" is the new site's 1000px shell. "case" is the published site's
      .page-shell geometry, which the ported case-study CSS assumes. */
  shell?: "default" | "case";
}

const {
  title,
  description = "Erik Drouhard is an AI Design Engineer specializing in human-agent interaction.",
  field = "full",
  noindex = false,
  bodyClass,
  shell = "default",
} = Astro.props;

const bodyClassName = [shell === "case" ? "case-page" : null, bodyClass]
  .filter(Boolean)
  .join(" ");
const shellClassName = shell === "case" ? "page-shell" : "shell";

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070d09" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/assets/erikdrouhard-logomark.svg" type="image/svg+xml" />
    <link rel="preload" href={newsreaderLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoLatin} as="font" type="font/woff2" crossorigin />
    {noindex && <meta name="robots" content="noindex" />}
    <title>{title}</title>

    {/*
      Runs before any stylesheet, so the saved theme is on <html> before the
      first paint and a light-mode visitor never sees a dark flash.
      Dark is the default for a first visit: prefers-color-scheme is
      deliberately ignored, because the design is authored dark-first.
    */}
    <script is:inline>
      (function () {
        var t = "dark";
        try {
          t = localStorage.getItem("ed-theme") || "dark";
        } catch (e) {}
        document.documentElement.setAttribute("data-theme", t);
      })();
    </script>

    <slot name="head" />

    <ClientRouter />
  </head>

  <body data-field={field} class={bodyClassName || undefined}>
    <a class="skip-link" href="#main">Skip to content</a>

    {/*
      transition:persist keeps the same canvas node across navigations, so the
      smoke keeps drifting through a page change instead of restarting — and
      field.js can adopt the running loop rather than building a second one.
    */}
    <canvas id="field" aria-hidden="true" transition:persist></canvas>

    <div class={shellClassName}>
      <Nav />
      <slot />
      <Footer />
      {/*
        Anything a page wants to hang below the footer but still inside the
        shell — /about/ puts the Easter-egg pocket here so the button is the
        last thing in the tab order and outside main.view.
      */}
      <slot name="after-footer" />
    </div>
    {/*
      Outside the shell on purpose: .shell goes inert and takes a transform
      while the Easter-egg sheet is up, and both would capture an overlay
      placed inside it — inert would kill the Close button, and a transformed
      ancestor becomes the containing block for position: fixed.
    */}
    <slot name="overlay" />

    <script>
      import "../scripts/site.js";
    </script>
  </body>
</html>
